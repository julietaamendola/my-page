\@writefile{lof}{\contentsline {figure}{\numberline {9.5}{\ignorespaces La función de Bessel \(J_0\) y los modos radiales del tambor. \textbf  {Izquierda:} \(J_0(s)\) con sus primeros ceros marcados, junto a la aproximación \(\sqrt  {2/(\mitpi s)}\cos (s-\mitpi /4)\) en punteado, que ya es muy buena a partir de \(s\approx 3\). \textbf  {Derecha:} los tres primeros modos radiales de la membrana circular, \(J_0(j_{0,p}\,r/R_0)\). El borde tiene que caer en un cero de \(J_0\), así que el modo \(p\) usa el pedazo de la curva que va hasta el cero número \(p\), y tiene \(p-1\) círculos nodales.}}{188}{figure.caption.129}\protected@file@percent }
\newlabel{fig-hip-bessel}{{9.5}{188}{La función de Bessel \(J_0\) y los modos radiales del tambor. \textbf {Izquierda:} \(J_0(s)\) con sus primeros ceros marcados, junto a la aproximación \(\sqrt {2/(\pi s)}\cos (s-\pi /4)\) en punteado, que ya es muy buena a partir de \(s\approx 3\). \textbf {Derecha:} los tres primeros modos radiales de la membrana circular, \(J_0(j_{0,p}\,r/R_0)\). El borde tiene que caer en un cero de \(J_0\), así que el modo \(p\) usa el pedazo de la curva que va hasta el cero número \(p\), y tiene \(p-1\) círculos nodales}{figure.caption.129}{}}
