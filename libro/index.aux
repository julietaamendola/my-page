\BKM@entry{id=130,dest={73756273656374696F6E2E392E352E33},srcline={12754},srcfile={2E2F696E6465782E746578}}{5C3337365C3337375C303030455C303030735C303030745C303030615C303030625C303030695C3030306C5C303030695C303030645C303030615C30303064}
\@writefile{lof}{\contentsline {figure}{\numberline {9.3}{\ignorespaces La regla del paralelogramo. \textbf  {Izquierda:} en el plano \((x,t)\) el paralelogramo tiene los lados sobre las dos familias de características, que acá son rectas de pendiente \(\pm 1/a\). \textbf  {Derecha:} el mismo paralelogramo en las coordenadas características \((\mitxi ,\miteta )\) es un rectángulo con lados paralelos a los ejes. Como \(u = f(\mitxi )+g(\miteta )\), cada vértice lleva un valor de \(f\) y uno de \(g\), y los vértices opuestos suman lo mismo.}}{167}{figure.caption.106}\protected@file@percent }
\newlabel{fig-hip-paralelogramo}{{9.3}{167}{La regla del paralelogramo. \textbf {Izquierda:} en el plano \((x,t)\) el paralelogramo tiene los lados sobre las dos familias de características, que acá son rectas de pendiente \(\pm 1/a\). \textbf {Derecha:} el mismo paralelogramo en las coordenadas características \((\xi ,\eta )\) es un rectángulo con lados paralelos a los ejes. Como \(u = f(\xi )+g(\eta )\), cada vértice lleva un valor de \(f\) y uno de \(g\), y los vértices opuestos suman lo mismo}{figure.caption.106}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.5.3}Estabilidad}{167}{subsection.9.5.3}\protected@file@percent }
\newlabel{sec-hip-estabilidad}{{9.5.3}{167}{Estabilidad}{subsection.9.5.3}{}}
\newlabel{prp-hip-estabilidad}{{9.3}{167}{Dependencia continua de los datos}{proposition.9.3}{}}
\newlabel{eq-hip-estabilidad}{{9.11}{168}{Dependencia continua de los datos}{section*.107}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9.4}{\ignorespaces Dos formas de depender de los datos. \textbf  {Izquierda:} para la ecuación de onda, una perturbación de tamaño \(\mitdelta = 10^{-3}\) en los datos. Si se perturba solo la forma, el error nunca pasa de \(\mitdelta \) (las ondas se llevan la perturbación, pero no la agrandan). Si se perturba la velocidad, crece como \(\mitdelta \,t\). La cota \ref {eq-hip-estabilidad}, en punteado, acota los dos casos. \textbf  {Derecha:} la misma perturbación en el ejemplo de Hadamard del sección~\ref {sec-hadamard}, con la distancia a la superficie en el lugar del tiempo, para una ondulación de longitud de onda \(2\mitpi /3\). En escala logarítmica, la recta de la izquierda es la curva de abajo, casi plana; la de Hadamard es una recta que cruza más de doce órdenes de magnitud.}}{168}{figure.caption.108}\protected@file@percent }
\newlabel{fig-hip-estabilidad}{{9.4}{168}{Dos formas de depender de los datos. \textbf {Izquierda:} para la ecuación de onda, una perturbación de tamaño \(\delta = 10^{-3}\) en los datos. Si se perturba solo la forma, el error nunca pasa de \(\delta \) (las ondas se llevan la perturbación, pero no la agrandan). Si se perturba la velocidad, crece como \(\delta \,t\). La cota \ref {eq-hip-estabilidad}, en punteado, acota los dos casos. \textbf {Derecha:} la misma perturbación en el ejemplo de Hadamard del sección~\ref {sec-hadamard}, con la distancia a la superficie en el lugar del tiempo, para una ondulación de longitud de onda \(2\pi /3\). En escala logarítmica, la recta de la izquierda es la curva de abajo, casi plana; la de Hadamard es una recta que cruza más de doce órdenes de magnitud}{figure.caption.108}{}}
